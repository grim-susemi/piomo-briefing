{
  "schema": "readability-manifest/1",
  "plan": "herdr-dag-active-tracking",
  "track": "W2",
  "task": 5,
  "language": "ko",
  "themes": [
    "light",
    "dark"
  ],
  "viewports": [
    {
      "name": "1180x700",
      "width": 1180,
      "height": 700,
      "mobile": false
    },
    {
      "name": "1440x900",
      "width": 1440,
      "height": 900,
      "mobile": false
    }
  ],
  "topPinContract": {
    "rowPx": 20,
    "maxRows": 8,
    "maxBottomPx": 160,
    "minTopPx": 0
  },
  "scrollBudgetContract": {
    "formula": "S = sum ceil(abs(delta) / visibleSize)",
    "initialActiveTitle": 0,
    "namedFlowMax": 1
  },
  "scrollAllowList": [
    {
      "id": "main-body",
      "selector": "#main",
      "region": "main",
      "direction": "vertical",
      "openState": "always",
      "note": "Single vertical scroll owner inside the fixed shell"
    },
    {
      "id": "sidebar-list",
      "selector": ".sh-scroll",
      "region": "sidebar (#main outside)",
      "direction": "vertical",
      "openState": "sideOpen",
      "note": "Sidebar list outside #main"
    },
    {
      "id": "open-modal-popover",
      "selector": "dialog[open], .pop, [data-ann-pop]",
      "region": "modal/popover",
      "direction": "vertical",
      "openState": "open (locks background scroll)",
      "note": "Open dialog or annotation popover only while open"
    },
    {
      "id": "office-canvas",
      "selector": "#office .of-pan, .of-scene",
      "region": "office dedicated canvas",
      "direction": "both",
      "openState": "view=office",
      "note": "Dedicated office canvas pan area"
    },
    {
      "id": "horizontal-flowbox",
      "selector": ".flowbox, .plan-lanes, .rbk-scroll, .stabs, .sh-tabs",
      "region": "horizontal-only strip/table",
      "direction": "horizontal",
      "openState": "overflowX>0, overflowY=hidden/visible",
      "note": "Horizontal-only overflow; table horizontal overflow is tracked separately and never hidden in vertical owner count"
    }
  ],
  "forbiddenVerticalScrollers": [
    ".pf-detail",
    "#pf-sec-profiles",
    ".pf-roles",
    ".pf-tray",
    ".pf-panes"
  ],
  "consumers": [
    {
      "id": "overview-cards",
      "consumer": "view.js card/renderOverview -> page.js",
      "files": [
        "src/page/view.js",
        "src/page/page.js",
        "src/page/page.css"
      ],
      "scope": "IN",
      "treatment": "project/session 경계 내 중첩 card 평면화; isFirst 강제 펼침 제거, 실제 활성·사용자 펼침만 우선"
    },
    {
      "id": "convo-and-blocks-kit",
      "consumer": "convo-view.js, blocks.js BriefView.kit",
      "files": [
        "src/page/convo-view.js",
        "src/page/blocks.js",
        "src/page/blocks.css"
      ],
      "scope": "IN",
      "treatment": "공통 카드·결정·자료 행 평면화 (.scard, .dcard, .rbk)"
    },
    {
      "id": "common-css-and-shell",
      "consumer": "page.css .card/.dcard, convo.css .scard, shell.css",
      "files": [
        "src/page/page.css",
        "src/page/convo.css",
        "src/page/shell.css",
        "src/page/tokens.css"
      ],
      "scope": "IN",
      "treatment": "공통 시각 계층·본문 #main 단일 세로 scroll 소유권"
    },
    {
      "id": "profiles-view",
      "consumer": "profiles-view.css .pf-card + profiles JS",
      "files": [
        "src/page/profiles-view.css",
        "src/page/profiles-view.js",
        "src/page/generated/profiles-view.generated.mjs"
      ],
      "scope": "IN",
      "treatment": "평면행·단일 본문(#main)·dirty/focus 보존; .pf-detail/#pf-sec-profiles/.pf-roles/.pf-tray/.pf-panes 세로 스크롤 제거"
    },
    {
      "id": "plan-and-workers",
      "consumer": "plan-view .plan-box, workers-view",
      "files": [
        "src/page/plan-view.js",
        "src/page/plan-view.css",
        "src/page/workers-view.js",
        "src/page/workers-view.css"
      ],
      "scope": "IN",
      "treatment": "공통 섹션·접힘; 활성(in_progress/running) 기본 펼침, 비활성 요약행"
    },
    {
      "id": "office-kit-consumer",
      "consumer": "office-view.js BriefView.kit consumer part",
      "files": [
        "src/page/office-view.js"
      ],
      "scope": "IN",
      "treatment": "공통 카드(BriefView.kit.answerBox) 변경 호환, 전용 office canvas 재설계 OUT"
    },
    {
      "id": "sibling-out-of-scope",
      "consumer": "cards-view.css .mcards-*, office.css dedicated content",
      "files": [
        "src/page/cards-view.js",
        "src/page/cards-view.css",
        "src/page/office.css"
      ],
      "scope": "OUT",
      "treatment": "전용 카드/캔버스 기능 재설계 제외. 공통 shell 영향·입력 회귀만 검사"
    }
  ],
